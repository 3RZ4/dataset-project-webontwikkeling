<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <title><%= artist.name %></title>
    <link rel="stylesheet" href="/css/style.css" />
  </head>
  <body>
    <%- include('navbar') %>

    <div class="content">
      <div class="detail-card">
        <img src="<%= artist.imageUrl %>" alt="<%= artist.name %>" />
        <h1><%= artist.name %></h1>
        <p><%= artist.description %></p>
        <p>Genre: <%= artist.genre %></p>
        <p>Age: <%= artist.age %></p>
        <p>Hobbies: <%= artist.hobbies.join(', ') %></p>
        <p>Birthdate: <%= artist.birthDate %></p>
        <h3>Record Label</h3>
        <p>
          <a href="/labels/<%= artist.recordLabel.id %>"
            ><%= artist.recordLabel.name %></a
          >
        </p>
        <a class="btn" href="/artists">← Back</a>
      </div>
    </div>
  </body>
</html>
