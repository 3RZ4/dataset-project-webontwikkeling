<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Artists</title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>

<%- include('navbar') %>

<div class="content">
    <h1>Artists</h1>

    <form method="GET" class="search-row">
        <input type="text" name="search" placeholder="Search name..." value="<%= search || '' %>">
        <input type="hidden" name="sort" value="<%= sort || '' %>">
        <input type="hidden" name="order" value="<%= order || '' %>">
        <button type="submit">Search</button>
    </form>

    <div class="sort-row">
        <span>Sort by:</span>
        <a href="?search=<%= search %>&sort=name&order=<%= sort === 'name' && order === 'asc' ? 'desc' : 'asc' %>">
            Name <%= sort === 'name' ? (order === 'asc' ? '↑' : '↓') : '' %>
        </a>
        <a href="?search=<%= search %>&sort=age&order=<%= sort === 'age' && order === 'asc' ? 'desc' : 'asc' %>">
            Age <%= sort === 'age' ? (order === 'asc' ? '↑' : '↓') : '' %>
        </a>
        <a href="?search=<%= search %>&sort=genre&order=<%= sort === 'genre' && order === 'asc' ? 'desc' : 'asc' %>">
            Genre <%= sort === 'genre' ? (order === 'asc' ? '↑' : '↓') : '' %>
        </a>
    </div>

    <div class="cards">
        <% artists.forEach(a => { %>
            <div class="card">
                <img src="<%= a.imageUrl %>" alt="<%= a.name %>" />
                <div class="card-body">
                    <h2><%= a.name %></h2>
                    <p><%= a.genre %> · <%= a.age %> jaar</p>
                    <a class="view-link" href="/artists/<%= a.id %>">View →</a>
                    <% if (user && user.role === "ADMIN") { %>
                        <br/>
                        <a class="btn-edit" href="/artists/<%= a.id %>/edit">Edit</a>
                    <% } %>
                </div>
            </div>
        <% }) %>
    </div>
</div>

</body>
</html>
